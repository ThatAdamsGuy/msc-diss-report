<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
	<!-- Use a repository-local global packages folder so CI/developer machines don't rely on
		 machine-specific Visual Studio fallback package folders. -->
	<add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
