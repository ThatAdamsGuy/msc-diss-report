<Window x:Class="UndercutAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UndercutAnalyser"
        mc:Ignorable="d"
        Title="Undercut Prediction Tool" Height="900" Width="1600">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Event Selection Area -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="#666666">Selected Event</TextBlock>
                <TextBlock x:Name="SelectedEventDisplay" FontSize="14" FontWeight="Bold" Margin="0,4,0,0">No event selected</TextBlock>
                <Button x:Name="EventButton" Content="Choose Event" Width="120" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Navigation Buttons + Trace Controls -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ParametersButton" Content="Parameters" Width="100" Margin="0,0,8,0" />
                <Button x:Name="PredictButton" Content="Predict" Width="100" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="RawDataButton" Content="Raw Data" Width="100" Margin="0,0,12,0" IsEnabled="False" />
            </StackPanel>

            <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="8,4" CornerRadius="4" DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Engineering Trace" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="IncludePitLapsCheckBox" Content="Include pit laps" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="IncludeScVscLapsCheckBox" Content="Include SC/VSC laps" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ApplyFuelCorrectionCheckBox" Content="Apply fuel correction" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Legend sort:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="LegendSortComboBox" Width="170" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Driver Number"/>
                        <ComboBoxItem Content="Team, then Number"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Main Race Trace Area -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <WrapPanel x:Name="TraceLegendPanel" Orientation="Horizontal" />
                </ScrollViewer>

                <Grid Grid.Row="1" x:Name="RaceTraceHost" />
            </Grid>
        </Border>
    </Grid>
</Window>
