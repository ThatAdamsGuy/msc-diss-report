<Window x:Class="UndercutAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UndercutAnalyser"
        mc:Ignorable="d"
        Title="Undercut Prediction Tool" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1010" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Event Selection Area -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0">
                <StackPanel HorizontalAlignment="Left" Width="775">
                    <TextBlock FontSize="12" Foreground="#666666">Selected Event</TextBlock>
                    <TextBlock x:Name="SelectedEventDisplay" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" ToolTip="Hover for details">No event selected</TextBlock>
                    <Button x:Name="EventButton" Content="Choose Event" Width="120" Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="0" Grid.Column="1">
                <Button x:Name="FullScanExportCsvButton" Content="Export Full Scan CSV" Width="140" IsEnabled="False" Margin="5"/>
                <Button x:Name="SingleScanExportCsvButton" Content="Export Single Driver Scan CSV" Width="140" IsEnabled="False" Margin="5"/>
            </StackPanel>
        </Grid>

        <!-- Row 1, Col 0: Scan/Raw buttons -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ScanAllDriversButton" Content="Scan All Drivers" Width="140" Height="40" Margin="0,0,8,0" IsEnabled="False" HorizontalAlignment="Left" />
            <Button x:Name="RawDataButton" Content="Raw Data" Width="100" Height="20" Margin="0,0,8,0" IsEnabled="False" HorizontalAlignment="Left" />
            <Button x:Name="PredictionScanButton" Content="Prediction / Scan" Width="130" Height="20" IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Row 2, Col 0: Engineering Trace options -->
        <Border Grid.Row="2" Grid.Column="0" Margin="10" Padding="5"  BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Engineering Trace" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="IncludePitLapsCheckBox" Content="Include pit laps" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="IncludeScVscLapsCheckBox" Content="Include SC/VSC laps" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ApplyFuelCorrectionCheckBox" Content="Apply fuel correction" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Legend sort:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LegendSortComboBox" Width="170" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="Driver Number"/>
                    <ComboBoxItem Content="Team, then Number"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Row 3, Col 0: Single Driver Scenario -->
        <Border Grid.Row="3" Grid.Column="0" Margin="10"  BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Hidden"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=RightPanelTabControl, Path=SelectedIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="Single Driver Scenario" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="Minimum tyre age (laps):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ScanMinTyreAgeBox" Width="50" Text="5" Margin="0,0,14,0" HorizontalContentAlignment="Right"/>
                    <Button x:Name="ScanSingleDriverButton" Content="Scan Single Driver" Width="140" IsEnabled="False" Margin="0,0,10,0"/>
                    <TextBlock Text="Scan selected attacking driver against all eligible targets." VerticalAlignment="Center" Foreground="#666666" FontSize="11"/>
                </StackPanel>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Attacking Driver Scenario">
                        <Grid Margin="6,4,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Driver"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanSingleAttackerCombo" Width="180" Margin="0,0,0,6" DisplayMemberPath="DisplayName"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Reference pace (s)"/>
                            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanAttackerPaceBox" Width="150" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Current compound"/>
                            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanAttackerCurrentCompoundBox" Width="150" Margin="0,0,0,6" IsReadOnly="True" Background="#F8F8F8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Current tyre age"/>
                            <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanAttackerTyreAgeBox" Width="90" Margin="0,0,0,6" IsReadOnly="True" Background="#F8F8F8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Replacement tyre"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="ScanAttackerReplCompoundCombo" Width="95" Margin="0,0,8,0">
                                    <ComboBoxItem Content="SOFT" IsSelected="True"/>
                                    <ComboBoxItem Content="MEDIUM"/>
                                    <ComboBoxItem Content="HARD"/>
                                </ComboBox>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="Age"/>
                                <TextBox x:Name="ScanAttackerReplAgeBox" Width="45"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Target Driver Scenario">
                        <Grid Margin="6,4,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Driver"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"  x:Name="ScanSingleTargetCombo" Width="180" Margin="0,0,0,6" DisplayMemberPath="DisplayName"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Reference pace (s)"/>
                            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanTargetPaceBox" Width="150" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Current compound"/>
                            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanTargetCurrentCompoundBox" Width="150" Margin="0,0,0,6" IsReadOnly="True" Background="#F8F8F8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Current tyre age"/>
                            <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanTargetTyreAgeBox" Width="90" Margin="0,0,0,6" IsReadOnly="True" Background="#F8F8F8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Replacement tyre"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="ScanTargetReplCompoundCombo" Width="95" Margin="0,0,8,0">
                                    <ComboBoxItem Content="SOFT" IsSelected="True"/>
                                    <ComboBoxItem Content="MEDIUM"/>
                                    <ComboBoxItem Content="HARD"/>
                                </ComboBox>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="Age"/>
                                <TextBox x:Name="ScanTargetReplAgeBox" Width="45"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="4" Header="Scenario">
                        <Grid Margin="6,4,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Target lap"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanTargetLapCombo" Width="90" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Starting gap (s)"/>
                            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="ScanStartingGapBox" Width="90" IsReadOnly="True" Background="#F8F8F8" Margin="0,0,0,6"/>

                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SimulateSingleUndercutButton" Content="Simulate Single Undercut" Height="24"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Right panel: tabs replacing former Parameters inputs -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Background="#2F80ED" BorderBrush="#1F5FB4" BorderThickness="1" CornerRadius="4" Padding="8" Margin="10" Height="440">
            <TabControl x:Name="RightPanelTabControl">
                <TabItem Header="Parameters">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Parameters Section -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Prediction Parameters" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Row="0" Grid.Column="0" Header="Fuel">
                                    <StackPanel Margin="6,4,6,6">
                                        <TextBlock Text="Fuel seconds per 10kg"/>
                                        <TextBox x:Name="FuelSecondsPer10KgBox" Width="110" Margin="0,3,0,8" TextChanged="FuelSettings_TextChanged"/>
                                        <TextBlock Text="Fuel kg"/>
                                        <TextBox x:Name="FuelKgBox" Width="110" Margin="0,3,0,0" TextChanged="FuelSettings_TextChanged"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="0" Grid.Column="2" Header="Scenario">
                                    <StackPanel Margin="6,4,6,6">
                                        <TextBlock Text="Target response (laps)"/>
                                        <TextBox x:Name="TargetResponseBox" Width="110" Margin="0,3,0,8" TextChanged="ScenarioSettings_TextChanged"/>
                                        <TextBlock Text="Marginal threshold (s)"/>
                                        <TextBox x:Name="MarginalThresholdBox" Width="110" Margin="0,3,0,0" TextChanged="ScenarioSettings_TextChanged"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="0" Grid.Column="4" Header="Traffic">
                                    <StackPanel Margin="6,4,6,6">
                                        <TextBlock Text="Traffic penalty (s)"/>
                                        <TextBox x:Name="TrafficPenaltyBox" Width="110" Margin="0,3,0,8" TextChanged="TrafficSettings_TextChanged"/>
                                        <CheckBox x:Name="ApplyAttackerTrafficCheckBox" Content="Apply to attacker" Margin="0,0,0,4" Checked="TrafficFlags_Changed" Unchecked="TrafficFlags_Changed"/>
                                        <CheckBox x:Name="ApplyTargetTrafficCheckBox" Content="Apply to target" Checked="TrafficFlags_Changed" Unchecked="TrafficFlags_Changed"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="0" Grid.Column="6" Header="Pit Stop">
                                    <StackPanel Margin="6,4,6,6">
                                        <TextBlock Text="Pit lane loss (s)"/>
                                        <TextBox x:Name="PitLaneLossBox" Width="110" Margin="0,3,0,0" TextChanged="PitStopSettings_TextChanged"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <Button x:Name="ResetParamsButton" Content="Reset to defaults" Width="140" Margin="0,8,0,16"/>

                            <Separator Margin="0,0,0,8"/>

                            <!-- Results Section -->
                            <TextBlock Text="Results" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="MainScanShowAheadCheckBox" Content="Ahead" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="MainScanShowMarginalCheckBox" Content="Marginal" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="MainScanShowBehindCheckBox" Content="Behind" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Results Grid with Scrolling -->
                        <DataGrid x:Name="MainScanSingleGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="#D0D0D0" BorderThickness="1"
                                  Margin="0,0,0,8">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="Ahead">
                                            <Setter Property="Background" Value="#DFF6DD"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="Marginal">
                                            <Setter Property="Background" Value="#FFF4D6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="Behind">
                                            <Setter Property="Background" Value="#FBE4E6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lap" Binding="{Binding DecisionLap}" Width="45"/>
                                <DataGridTextColumn Header="Attacking" Binding="{Binding Attacker}" Width="70"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="70"/>
                                <DataGridTextColumn Header="Att. tyre" Binding="{Binding AttackerCompound}" Width="70"/>
                                <DataGridTextColumn Header="Att. age" Binding="{Binding AttackerTyreAge}" Width="55"/>
                                <DataGridTextColumn Header="Tar. tyre" Binding="{Binding TargetCompound}" Width="70"/>
                                <DataGridTextColumn Header="Tar. age" Binding="{Binding TargetTyreAge}" Width="55"/>
                                <DataGridTextColumn Header="G₀" Binding="{Binding G0}" Width="70"/>
                                <DataGridTextColumn Header="Gap@PitLap" Binding="{Binding GapAtTargetPitLapComplete}" Width="95"/>
                                <DataGridTextColumn Header="ΔG@PitLap" Binding="{Binding DeltaGAtTargetPitLapComplete}" Width="95"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="MainScanSingleStatusText" Grid.Row="1" Foreground="#666666" FontSize="11" VerticalAlignment="Bottom"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Tyres">
                    <DataGrid x:Name="TyreGrid" Margin="8" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" CellEditEnding="TyreGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Compound" Binding="{Binding Compound}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Pace" Binding="{Binding PaceOffset, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Deg" Binding="{Binding DegradationRate, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Warmup" Binding="{Binding WarmUpPenalty, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Life Min" Binding="{Binding MinLaps, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Life Max" Binding="{Binding MaxLaps, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem x:Name="ScanSingleDriverTab" Header="Scan Single Driver">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="SingleScanShowAheadCheckBox" Content="Ahead" IsChecked="True" Margin="0,0,10,0"/>
                            <CheckBox x:Name="SingleScanShowMarginalCheckBox" Content="Marginal" IsChecked="True" Margin="0,0,10,0"/>
                            <CheckBox x:Name="SingleScanShowBehindCheckBox" Content="Behind" IsChecked="True"/>
                        </StackPanel>

                        <DataGrid x:Name="ScanSingleResultsGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="#D0D0D0" BorderThickness="1">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="Ahead">
                                            <Setter Property="Background" Value="#DFF6DD"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="Marginal">
                                            <Setter Property="Background" Value="#FFF4D6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="Behind">
                                            <Setter Property="Background" Value="#FBE4E6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lap" Binding="{Binding DecisionLap}" Width="45"/>
                                <DataGridTextColumn Header="Attacking" Binding="{Binding Attacker}" Width="70"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="70"/>
                                <DataGridTextColumn Header="Att. tyre" Binding="{Binding AttackerCompound}" Width="70"/>
                                <DataGridTextColumn Header="Att. age" Binding="{Binding AttackerTyreAge}" Width="55"/>
                                <DataGridTextColumn Header="Tar. tyre" Binding="{Binding TargetCompound}" Width="70"/>
                                <DataGridTextColumn Header="Tar. age" Binding="{Binding TargetTyreAge}" Width="55"/>
                                <DataGridTextColumn Header="G₀" Binding="{Binding G0}" Width="70"/>
                                <DataGridTextColumn Header="Gap@PitLap" Binding="{Binding GapAtTargetPitLapComplete}" Width="95"/>
                                <DataGridTextColumn Header="ΔG@PitLap" Binding="{Binding DeltaGAtTargetPitLapComplete}" Width="95"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" x:Name="ScanSingleResultsStatusText" Foreground="#666666" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                </TabItem>
                
            </TabControl>
        </Border>

        <!-- Main workspace area: Race Trace Graph -->
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="0">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <WrapPanel x:Name="TraceLegendPanel" Orientation="Horizontal" />
                </ScrollViewer>

                <Grid Grid.Row="1" x:Name="RaceTraceHost" />
            </Grid>
        </Border>
    </Grid>
</Window>
