<Window x:Class="UndercutAnalyser.EventSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Event" Height="600" Width="600">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter Box -->
        <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0,0,0,8" />

        <!-- Status / Event Count -->
        <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="11" Foreground="#666666" Margin="0,0,0,4" />

        <!-- Events List -->
        <ListView x:Name="EventsListView" Grid.Row="2" ItemsSource="{Binding EventsView}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <!-- Small country flag on the left -->
                            <Image Grid.Column="0" Width="32" Height="20" Margin="4,0,8,0" Source="{Binding CountryFlag}" Stretch="Uniform" />

                            <!-- Central text: Year - Meeting Name, and circuit -->
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding Year}" /><Run Text=" - " /><Run Text="{Binding MeetingName}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#666666" Text="{Binding CircuitShortName}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding Name}" Margin="0,8,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="100" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Cancel" Width="100" />
        </StackPanel>
    </Grid>
</Window>
