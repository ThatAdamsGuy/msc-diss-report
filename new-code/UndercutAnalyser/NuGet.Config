<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
	<!-- Use a project-local global packages folder so IDE/CI use project-scoped packages -->
	<add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <!-- Prevent MSBuild/NuGet from referencing machine-specific fallback folders that may not exist on CI/dev machines -->
  <fallbackPackageFolders>
	<clear />
  </fallbackPackageFolders>
  <packageSources>
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

