<Window x:Class="UndercutAnalyser.ParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameters" Height="480" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Fuel seconds per 10kg:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FuelSecondsPer10KgBox" Width="80" Margin="0,0,16,0" HorizontalContentAlignment="Right" />
                <TextBlock Text="Fuel kg:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FuelKgBox" Width="80" HorizontalContentAlignment="Right" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="TyreGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  ItemsSource="{Binding TyreRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tyre" Binding="{Binding Compound}" IsReadOnly="True" Width="120" />

                <DataGridTemplateColumn Header="Pace Offset" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding PaceOffset, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding IsEditable}"
                                     HorizontalContentAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Padding="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Degradation Rate" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding DegradationRate, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding IsEditable}"
                                     HorizontalContentAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     Padding="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Laps (Min - Max)" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBox Width="50"
                                         Text="{Binding MinLaps, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center"
                                         Padding="2" />
                                <TextBlock Text="-" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox Width="50"
                                         Text="{Binding MaxLaps, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center"
                                         Padding="2" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="100" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Cancel" Width="100" />
        </StackPanel>
    </Grid>
</Window>
