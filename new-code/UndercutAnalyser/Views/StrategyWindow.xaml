<Window x:Class="UndercutAnalyser.StrategyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy" Height="840" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Closing="StrategyWindow_Closing">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,4,8,8"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,3,8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <!-- Scan grid row colouring: opportunities get a light green tint -->
        <Style x:Key="ScanRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpportunity}" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs" Margin="8" SelectionChanged="MainTabs_SelectionChanged">

        <!-- ══════════════════════════════════════════════════════════════
             TAB 1 — PARAMETERS
             ══════════════════════════════════════════════════════════════ -->
        <TabItem x:Name="ParametersTab" Header="Parameters">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fuel row -->
                <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Fuel seconds per 10 kg:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="FuelSecondsPer10KgBox" Width="80" Margin="0,0,16,0"
                                 HorizontalContentAlignment="Right"
                                 LostFocus="FuelBox_LostFocus"/>
                        <TextBlock Text="Fuel kg:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="FuelKgBox" Width="80"
                                 HorizontalContentAlignment="Right"
                                 LostFocus="FuelBox_LostFocus"/>
                    </StackPanel>
                </Border>

                <!-- Info note -->
                <TextBlock Grid.Row="1" Margin="0,0,0,6" Foreground="#666666" FontSize="11"
                           Text="Changes are applied immediately. Tyre pace offsets are relative to Soft (reference compound = 0)."/>

                <!-- Tyre grid -->
                <DataGrid x:Name="TyreGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          ItemsSource="{Binding TyreRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tyre" Binding="{Binding Compound}" IsReadOnly="True" Width="120"/>

                        <DataGridTemplateColumn Header="Pace Offset (s)" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PaceOffset, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding IsEditable}"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             Padding="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Degradation Rate (s/lap)" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DegradationRate, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding IsDegradationEditable}"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             Padding="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Laps (Min – Max)" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBox Width="50" Text="{Binding MinLaps, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center" Padding="2"/>
                                        <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding MaxLaps, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center" Padding="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Reset button -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ResetParamsButton" Content="Reset to defaults" Width="140"
                            Click="ResetParamsButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════════
             TAB 2 — PREDICT
             ══════════════════════════════════════════════════════════════ -->
        <TabItem x:Name="PredictTab" Header="Predict">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ── Scenario ──────────────────────────────────────────── -->
                        <GroupBox Header="Scenario">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="Attacking driver:"/>
                                <ComboBox Grid.Column="1" x:Name="AttackerCombo"
                                          SelectionChanged="AttackerCombo_SelectionChanged"/>

                                <Label Grid.Column="3" Content="Target driver:"/>
                                <ComboBox Grid.Column="4" x:Name="TargetCombo"
                                          SelectionChanged="TargetCombo_SelectionChanged"/>

                                <Label Grid.Column="6" Content="Decision lap:"/>
                                <ComboBox Grid.Column="7" x:Name="DecisionLapCombo"
                                          SelectionChanged="DecisionLapCombo_SelectionChanged"/>

                                <Label Grid.Column="9" Content="Initial gap (s):"/>
                                <TextBox Grid.Column="10" x:Name="InitialGapBox"
                                         TextChanged="InitialGapBox_TextChanged"/>
                            </Grid>
                        </GroupBox>

                        <!-- ── Driver states ─────────────────────────────────────── -->
                        <GroupBox Header="Driver state at decision lap (Sector Line Two)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Attacking"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Target driver"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,6"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Reference pace (s):"/>
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="4,2">
                                    <TextBox x:Name="AttackerPaceBox" DockPanel.Dock="Left" Width="90"
                                             TextChanged="AttackerPaceBox_TextChanged"/>
                                    <TextBlock x:Name="AttackerPaceSource" Text="" Foreground="#888888"
                                               VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"/>
                                </DockPanel>
                                <DockPanel Grid.Row="1" Grid.Column="2" Margin="4,2">
                                    <TextBox x:Name="TargetPaceBox" DockPanel.Dock="Left" Width="90"
                                             TextChanged="TargetPaceBox_TextChanged"/>
                                    <TextBlock x:Name="TargetPaceSource" Text="" Foreground="#888888"
                                               VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"/>
                                </DockPanel>

                                <Label Grid.Row="2" Grid.Column="0" Content="Current compound:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="AttackerCurrentCompoundBox"
                                         Margin="4,2" IsReadOnly="True" Background="#F8F8F8"/>
                                <TextBox Grid.Row="2" Grid.Column="2" x:Name="TargetCurrentCompoundBox"
                                         Margin="4,2" IsReadOnly="True" Background="#F8F8F8"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="Current tyre age (laps):"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="AttackerTyreAgeBox"
                                         Margin="4,2" IsReadOnly="True" Background="#F8F8F8"/>
                                <TextBox Grid.Row="3" Grid.Column="2" x:Name="TargetTyreAgeBox"
                                         Margin="4,2" IsReadOnly="True" Background="#F8F8F8"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="Replacement tyre:"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="4,2">
                                    <ComboBox x:Name="AttackerReplCompoundCombo" Width="90" Margin="0,0,8,0"
                                              SelectionChanged="AttackerReplCompoundCombo_SelectionChanged">
                                        <ComboBoxItem Content="SOFT" IsSelected="True"/>
                                        <ComboBoxItem Content="MEDIUM"/>
                                        <ComboBoxItem Content="HARD"/>
                                    </ComboBox>
                                    <Label Content="Age:" Padding="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AttackerReplAgeBox" Width="50"
                                             TextChanged="AttackerReplAgeBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="4,2">
                                    <ComboBox x:Name="TargetReplCompoundCombo" Width="90" Margin="0,0,8,0"
                                              SelectionChanged="TargetReplCompoundCombo_SelectionChanged">
                                        <ComboBoxItem Content="SOFT" IsSelected="True"/>
                                        <ComboBoxItem Content="MEDIUM"/>
                                        <ComboBoxItem Content="HARD"/>
                                    </ComboBox>
                                    <Label Content="Age:" Padding="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TargetReplAgeBox" Width="50"
                                             TextChanged="TargetReplAgeBox_TextChanged"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- ── Model parameters ──────────────────────────────────── -->
                        <GroupBox Header="Model parameters">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Pit lane loss (s):"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PitLossBox"
                                         TextChanged="PitLossBox_TextChanged"/>

                                <Label Grid.Row="0" Grid.Column="3" Content="Warm up penalty (s):"/>
                                <TextBox Grid.Row="0" Grid.Column="4" x:Name="WarmUpBox"
                                         TextChanged="WarmUpBox_TextChanged"/>

                                <Label Grid.Row="0" Grid.Column="6" Content="Target response (laps):"/>
                                <TextBox Grid.Row="0" Grid.Column="7" x:Name="TargetResponseBox"
                                         TextChanged="TargetResponseBox_TextChanged"/>

                                <Label Grid.Row="0" Grid.Column="9" Content="Marginal threshold (s):"/>
                                <TextBox Grid.Row="0" Grid.Column="10" x:Name="MarginalBox"
                                         TextChanged="MarginalBox_TextChanged"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Traffic penalty (s):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TrafficPenaltyBox"
                                         TextChanged="TrafficPenaltyBox_TextChanged"/>

                                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="AttackerTrafficCheck"
                                              Content="Apply to attacking driver out lap"
                                              VerticalAlignment="Center" Margin="0,0,16,0"
                                              Checked="TrafficCheck_Changed" Unchecked="TrafficCheck_Changed"/>
                                    <CheckBox x:Name="TargetTrafficCheck"
                                              Content="Apply to target driver out lap"
                                              VerticalAlignment="Center"
                                              Checked="TrafficCheck_Changed" Unchecked="TrafficCheck_Changed"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- ── Result ─────────────────────────────────────────────── -->
                        <GroupBox x:Name="ResultGroup" Header="Prediction result" Visibility="Collapsed">
                            <StackPanel>

                                <Border x:Name="ClassificationBadge" CornerRadius="4" Padding="12,6"
                                        Margin="0,0,0,10" HorizontalAlignment="Left">
                                    <TextBlock x:Name="ClassificationText" FontSize="16" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <TextBlock x:Name="G0Label" Foreground="#444444" FontSize="11"
                                           Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <TextBlock Text="Gap at each evaluation point  (negative = attacking driver ahead)"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4"
                                            Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="TargetPitLapComplete" FontSize="11" Foreground="#666"/>
                                            <TextBlock x:Name="GapAtTargetPitLapCompleteLabel" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DeltaGAtTargetPitLapCompleteLabel" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                                            <TextBlock Text="(endpoint)" FontSize="10" Foreground="#999" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4"
                                            Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="TargetOutLapComplete" FontSize="11" Foreground="#666"/>
                                            <TextBlock x:Name="GapAtTargetOutLapCompleteLabel" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DeltaGAtTargetOutLapCompleteLabel" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                                            <TextBlock Text="(endpoint)" FontSize="10" Foreground="#999" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="BothDriversNormalLapComplete" FontSize="11" Foreground="#666"/>
                                            <TextBlock x:Name="GapAtBothDriversNormalLapCompleteLabel" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="DeltaGAtBothDriversNormalLapCompleteLabel" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                                            <TextBlock Text="(endpoint)" FontSize="10" Foreground="#999" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="Lap-by-lap breakdown" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DataGrid x:Name="LapGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderBrush="#D0D0D0" BorderThickness="1"
                                          MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Driver"     Binding="{Binding DriverLabel}"    Width="70"/>
                                        <DataGridTextColumn Header="Lap"        Binding="{Binding LapNumber}"      Width="45"/>
                                        <DataGridTextColumn Header="Type"       Binding="{Binding LapType}"        Width="70"/>
                                        <DataGridTextColumn Header="Compound"   Binding="{Binding Compound}"       Width="80"/>
                                        <DataGridTextColumn Header="Tyre age"   Binding="{Binding TyreAge}"        Width="70"/>
                                        <DataGridTextColumn Header="Base (s)"   Binding="{Binding Base}"           Width="70"/>
                                        <DataGridTextColumn Header="Compound Δ" Binding="{Binding CompoundOffset}" Width="90"/>
                                        <DataGridTextColumn Header="Degradation" Binding="{Binding Degradation}"  Width="90"/>
                                        <DataGridTextColumn Header="Warm up"    Binding="{Binding WarmUp}"         Width="75"/>
                                        <DataGridTextColumn Header="Traffic"    Binding="{Binding Traffic}"        Width="65"/>
                                        <DataGridTextColumn Header="Pit loss"   Binding="{Binding PitLoss}"        Width="65"/>
                                        <DataGridTextColumn Header="Total (s)"  Binding="{Binding Total}"          Width="75"/>
                                        <DataGridTextColumn Header="Cumul. (s)" Binding="{Binding Cumulative}"     Width="80"/>
                                        <DataGridTextColumn Header="Gap (s)"    Binding="{Binding Gap}"            Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel x:Name="WarningPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Warnings" FontWeight="SemiBold" Foreground="#CC6600" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="WarningList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#CC6600" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock x:Name="ValidationText" Foreground="#CC0000" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Visibility="Collapsed"/>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="RunButton" Content="Run Prediction" Width="130" Margin="0,0,8,0"
                            Click="RunButton_Click"/>
                    <Button x:Name="ExportCsvButton" Content="Export CSV" Width="110" IsEnabled="False"
                            Click="ExportCsvButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════════
             TAB 3 — SCAN
             ══════════════════════════════════════════════════════════════ -->
        <TabItem x:Name="ScanTab" Header="Scan">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Controls row -->
                <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1"
                        Padding="10,6" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Driver:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ScanDriverCombo" Width="180" Margin="0,0,20,0"
                                  VerticalAlignment="Center"/>

                        <TextBlock Text="Minimum tyre age (laps):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ScanMinTyreAgeBox" Width="50" Text="5"
                                 HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,20,0"/>

                        <Button x:Name="ScanButton" Content="Scan Driver" Width="110"
                                Margin="0,0,8,0" Click="ScanButton_Click"/>
                        <Button x:Name="ScanAllButton" Content="Scan All Drivers" Width="130"
                                Click="ScanAllButton_Click"/>

                        <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center"
                                   Foreground="#666666" FontSize="11" Margin="16,0,0,0"/>
                        <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True"
                                     Width="120" Height="10" Margin="10,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Results grid -->
                <DataGrid x:Name="ScanGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#D0D0D0" BorderThickness="1"
                          SelectionMode="Single"
                          RowStyle="{StaticResource ScanRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lap"      Binding="{Binding DecisionLap}"      Width="45"/>
                        <DataGridTextColumn Header="Attacking" Binding="{Binding Attacker}"         Width="75"/>
                        <DataGridTextColumn Header="Target"   Binding="{Binding Target}"            Width="75"/>
                        <DataGridTextColumn Header="Att. tyre" Binding="{Binding AttackerCompound}" Width="80"/>
                        <DataGridTextColumn Header="Att. age"  Binding="{Binding AttackerTyreAge}"  Width="65"/>
                        <DataGridTextColumn Header="Tar. tyre" Binding="{Binding TargetCompound}"   Width="80"/>
                        <DataGridTextColumn Header="Tar. age"  Binding="{Binding TargetTyreAge}"    Width="65"/>
                        <DataGridTextColumn Header="G₀ (s)"   Binding="{Binding G0}"               Width="90"/>
                        <DataGridTextColumn Header="Gap TargetPitLapComplete"  Binding="{Binding GapAtTargetPitLapComplete}"          Width="175"/>
                        <DataGridTextColumn Header="Gap TargetOutLapComplete"  Binding="{Binding GapAtTargetOutLapComplete}"          Width="175"/>
                        <DataGridTextColumn Header="Gap BothDriversNormalLapComplete"  Binding="{Binding GapAtBothDriversNormalLapComplete}"  Width="235"/>
                        <DataGridTextColumn Header="ΔG TargetPitLapComplete"   Binding="{Binding DeltaGAtTargetPitLapComplete}"      Width="175"/>
                        <DataGridTextColumn Header="Result"   Binding="{Binding Result}"             Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Export row -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ScanExportCsvButton" Content="Export Scan CSV" Width="140"
                            IsEnabled="False" Click="ScanExportCsvButton_Click"/>
                    <TextBlock x:Name="ScanRowCountText" VerticalAlignment="Center"
                               Foreground="#666666" FontSize="11" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>


